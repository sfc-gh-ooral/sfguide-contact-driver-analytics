# ────────────────────────────────────────────────────────────────
# Contact Driver Analytics — Live mode settings
# ────────────────────────────────────────────────────────────────
# Copy to .env.local (gitignored) and fill in, then restart `npm run dev`.
#   cp .env.example .env.local
# Without these, the app runs in Sample mode on built-in synthetic data.
# Never commit .env.local or your private key.

# Account identifier: <orgname>-<account_name> (Snowsight > account menu > View account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=<YOUR_USER>

# Option 1 (recommended): key-pair authentication (SNOWFLAKE_JWT)
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
# Register the public key (contents between the BEGIN/END lines) on your user:
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY='MIIBIjANBgkqh...';
# (If RSA_PUBLIC_KEY is already in use, set RSA_PUBLIC_KEY_2 instead.)
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# Only if you encrypted the key:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option 2: browser single sign-on (opens a browser window on first query)
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Option 3: password (not recommended; blocked where MFA is enforced)
# SNOWFLAKE_PASSWORD=

# Objects created by sql/setup.sql (these are the defaults)
SNOWFLAKE_ROLE=CONTACT_DRIVER_ROLE
SNOWFLAKE_WAREHOUSE=CONTACT_DRIVER_WH
SNOWFLAKE_DATABASE=CONTACT_DRIVER_EXAMPLE
SNOWFLAKE_SCHEMA=ANALYTICS

# Model for the AI Insights panel (AI_COMPLETE). Must be available in your region
# or through cross-region inference.
# CORTEX_MODEL=llama3.3-70b

# Snowpark Container Services: the OAuth token is read from /snowflake/session/token.
# SNOWFLAKE_HOST=
